<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="80dp">

        <!-- Encabezado -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Resumen"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:textColor="@color/text_primary"
            android:letterSpacing="-0.01"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Revisa todo antes de confirmar tu publicación"
            android:textSize="13sp"
            android:fontFamily="sans-serif-light"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="24dp" />

        <!-- Tag tipo -->
        <TextView
            android:id="@+id/tvTipo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipo: Curso"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05"
            android:textColor="@color/accent_primary"
            android:background="@drawable/bg_tag_curso"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:layout_marginBottom="20dp" />

        <!-- Card resumen -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardResumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/bg_card_elevated"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/bg_secondary"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Título -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TÍTULO"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_tertiary"
                    android:letterSpacing="0.10"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvTituloValor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="16dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/bg_secondary"
                    android:layout_marginBottom="16dp" />

                <!-- Descripción -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DESCRIPCIÓN"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_tertiary"
                    android:letterSpacing="0.10"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvDescripcionValor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-light"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingMultiplier="1.5"
                    android:layout_marginBottom="16dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/bg_secondary"
                    android:layout_marginBottom="16dp" />

                <!-- Extra (archivo o detalles clase) -->
                <TextView
                    android:id="@+id/tvExtraLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ARCHIVO"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_tertiary"
                    android:letterSpacing="0.10"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvExtraValor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-light"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingMultiplier="1.5"
                    android:layout_marginBottom="16dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/bg_secondary"
                    android:layout_marginBottom="16dp" />

                <!-- Precio -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRECIO"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_tertiary"
                    android:letterSpacing="0.10"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvPrecioValor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"
                    android:textColor="@color/accent_primary" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Botones -->
        <Button
            android:id="@+id/btnConfirmar"
            style="@style/SS.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="CONFIRMAR PUBLICACIÓN"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnRegresar"
            style="@style/SS.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Volver a editar" />

    </LinearLayout>
</ScrollView>