<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true"
    android:overScrollMode="never">

    <!-- Contenedor raíz con glows decorativos -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Glow azul arriba centro -->
        <View
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="-80dp"
            android:background="@drawable/bg_glow_blue"
            android:alpha="0.6" />

        <!-- Glow verde abajo derecha -->
        <View
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="60dp"
            android:layout_marginEnd="-40dp"
            android:background="@drawable/bg_glow_green"
            android:alpha="0.5" />

        <!-- Glow azul abajo izquierda -->
        <View
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="bottom|start"
            android:layout_marginBottom="100dp"
            android:layout_marginStart="-40dp"
            android:background="@drawable/bg_glow_blue"
            android:alpha="0.3" />

        <!-- Contenido principal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="72dp"
            android:paddingBottom="40dp">

            <!-- Logo + ícono -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="40dp">

                <!-- Ícono circular con gradiente -->
                <FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginBottom="20dp">
                    <View
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/bg_avatar_gradient" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="📚"
                        android:textSize="30sp" />
                </FrameLayout>

                <!-- SaberShare -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Saber"
                        android:textSize="36sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-condensed"
                        android:textColor="@color/text_primary"
                        android:letterSpacing="-0.02" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Share"
                        android:textSize="36sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-condensed"
                        android:textColor="@color/accent_primary"
                        android:letterSpacing="-0.02" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Comparte conocimiento · Aprende · Crece"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-light"
                    android:textColor="@color/text_tertiary"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Card formulario -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bienvenido de vuelta"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-condensed"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ingresa tus credenciales para continuar"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-light"
                        android:textColor="@color/text_tertiary"
                        android:layout_marginBottom="24dp" />

                    <!-- Campo usuario -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="USUARIO"
                        android:textSize="11sp"
                        android:textColor="@color/text_tertiary"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="6dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_email"
                        style="@style/SS.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Nombre de usuario"
                        android:layout_marginBottom="16dp"
                        app:startIconDrawable="@drawable/ic_person"
                        app:startIconTint="@color/text_tertiary"
                        app:boxStrokeColor="@color/accent_blue"
                        app:hintTextColor="@color/text_secondary">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_email"
                            style="@style/SS.TextInput.EditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName"
                            android:imeOptions="actionNext" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Campo contraseña -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CONTRASEÑA"
                        android:textSize="11sp"
                        android:textColor="@color/text_tertiary"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="6dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_password"
                        style="@style/SS.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Tu contraseña"
                        android:layout_marginBottom="8dp"
                        app:startIconDrawable="@drawable/ic_lock"
                        app:startIconTint="@color/text_tertiary"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/text_tertiary"
                        app:boxStrokeColor="@color/accent_blue"
                        app:hintTextColor="@color/text_secondary">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_password"
                            style="@style/SS.TextInput.EditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:imeOptions="actionDone" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Error -->
                    <TextView
                        android:id="@+id/tv_error_login"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/error"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:visibility="gone"
                        android:background="#1AEF4444"
                        android:padding="10dp"
                        android:layout_marginBottom="8dp" />

                    <!-- Progress -->
                    <ProgressBar
                        android:id="@+id/progress_login"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:visibility="gone"
                        android:layout_marginBottom="8dp"
                        android:indeterminateTint="@color/accent_blue" />

                    <!-- Botón iniciar sesión (azul gradiente) -->
                    <Button
                        android:id="@+id/btn_login"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_btn_blue_gradient"
                        android:text="🚀  INICIAR SESIÓN"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="0.05"
                        android:stateListAnimator="@null"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Separador o -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/border" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="o"
                    android:textColor="@color/text_tertiary"
                    android:textSize="13sp"
                    android:paddingHorizontal="12dp" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/border" />
            </LinearLayout>

            <!-- Botón registro (verde gradiente) -->
            <Button
                android:id="@+id/btn_ir_registro"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_login_gradient"
                android:text="Crear cuenta nueva →"
                android:textColor="@color/text_on_accent"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:stateListAnimator="@null"
                android:layout_marginBottom="20dp" />

            <!-- Footer -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Al continuar aceptas nuestros Términos de uso"
                android:textSize="11sp"
                android:textColor="@color/text_tertiary"
                android:gravity="center" />

        </LinearLayout>
    </FrameLayout>
</ScrollView>