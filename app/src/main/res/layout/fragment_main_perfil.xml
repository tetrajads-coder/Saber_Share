<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:overScrollMode="never"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="80dp">

        <!-- Hero del perfil -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/bg_secondary"
            android:paddingHorizontal="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="24dp"
            android:gravity="center">

            <!-- Avatar grande -->
            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_avatar"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tv_perfil_inicial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="U"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"
                    android:textColor="@color/accent_primary"
                    android:gravity="center" />
            </FrameLayout>

            <!-- Nombre -->
            <TextView
                android:id="@+id/tv_perfil_nombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre del Usuario"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="4dp" />

            <!-- Email -->
            <TextView
                android:id="@+id/tv_perfil_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="email@ejemplo.com"
                android:textSize="13sp"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="12dp" />

            <!-- Badge de rol -->
            <TextView
                android:id="@+id/tv_perfil_rol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USUARIO"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.10"
                android:textColor="@color/accent_primary"
                android:background="@drawable/bg_tag_curso"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp" />
        </LinearLayout>

        <!-- Stats rápidas (3 columnas) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/bg_card"
            android:paddingVertical="16dp">

            <!-- Publicaciones -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_perfil_n_publicaciones"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"
                    android:textColor="@color/accent_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Publicaciones"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-light"
                    android:textColor="@color/text_tertiary" />
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="40dp"
                android:background="@color/border" android:layout_gravity="center" />

            <!-- Ventas -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_perfil_n_ventas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"
                    android:textColor="@color/accent_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ventas"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-light"
                    android:textColor="@color/text_tertiary" />
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="40dp"
                android:background="@color/border" android:layout_gravity="center" />

            <!-- Calificación -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_perfil_calificacion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★ 0.0"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"
                    android:textColor="@color/star_filled" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reputación"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-light"
                    android:textColor="@color/text_tertiary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Opciones de menú -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp">

            <!-- Ítem: Editar perfil -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_editar_perfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="✏️  Editar perfil"
                        android:textSize="14sp" android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_primary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="20sp" android:textColor="@color/text_tertiary" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Ítem: Historial -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_historial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="📋  Historial de compras"
                        android:textSize="14sp" android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_primary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="20sp" android:textColor="@color/text_tertiary" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Ítem: Estadísticas (solo Chalán/Admin) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_estadisticas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="📊  Mis estadísticas"
                        android:textSize="14sp" android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_primary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="20sp" android:textColor="@color/text_tertiary" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Ítem: Agenda (solo Chalán) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_agenda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="📅  Gestionar agenda"
                        android:textSize="14sp" android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_primary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="20sp" android:textColor="@color/text_tertiary" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:id="@+id/card_saldo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/accent_primary"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="💰  Saldo pendiente"
                            android:textSize="14sp" android:fontFamily="sans-serif-medium"
                            android:textColor="@color/text_primary" />
                        <TextView android:id="@+id/tv_saldo_pendiente"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Cargando..."
                            android:textSize="12sp" android:textColor="@color/accent_primary" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="20sp" android:textColor="@color/text_tertiary" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Cerrar sesión -->
            <Button
                android:id="@+id/btn_cerrar_sesion"
                style="@style/SS.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cerrar sesión"
                android:textColor="@color/error"
                app:strokeColor="@color/error" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
