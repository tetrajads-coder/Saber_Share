<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_primary"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_comprar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrowback"
            app:navigationIconTint="@color/text_primary"
            app:title="Checkout"
            app:titleTextColor="@color/text_primary"
            app:titleTextAppearance="@style/SS.Text.H2"
            android:background="@color/bg_primary" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:paddingBottom="104dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Etiqueta de pasos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <!-- Paso 1 (activo) -->
                <FrameLayout
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_step_active">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="1"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_on_accent"
                        android:gravity="center" />
                </FrameLayout>

                <View android:layout_width="20dp" android:layout_height="1dp"
                    android:background="@color/accent_primary" android:layout_marginHorizontal="4dp" />

                <!-- Paso 2 -->
                <FrameLayout
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_step_inactive">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="2"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_tertiary"
                        android:gravity="center" />
                </FrameLayout>

                <View android:layout_width="20dp" android:layout_height="1dp"
                    android:background="@color/border" android:layout_marginHorizontal="4dp" />

                <!-- Paso 3 -->
                <FrameLayout
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_step_inactive">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="3"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_tertiary"
                        android:gravity="center" />
                </FrameLayout>

                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Revisa → Paga → Listo"
                    android:textSize="11sp"
                    android:textColor="@color/text_tertiary"
                    android:fontFamily="sans-serif-light"
                    android:gravity="end" />
            </LinearLayout>

            <!-- Card del item -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/tv_comprar_tipo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CURSO"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.08"
                        android:textColor="@color/accent_primary"
                        android:background="@drawable/bg_tag_curso"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/tv_comprar_titulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nombre del curso"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-condensed"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tv_comprar_descripcion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Descripción del item"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-light"
                        android:textColor="@color/text_secondary"
                        android:lineSpacingMultiplier="1.5"
                        android:layout_marginBottom="14dp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/divider" android:layout_marginBottom="14dp" />

                    <!-- Total -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="TOTAL A PAGAR"
                            android:textSize="10sp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/text_tertiary"
                            android:letterSpacing="0.10" />

                        <TextView
                            android:id="@+id/tv_comprar_precio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$0.00 MXN"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-condensed"
                            android:textColor="@color/accent_primary" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card seguridad PayPal -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#0C1A2D"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#0284C7"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔒"
                        android:textSize="24sp"
                        android:layout_marginEnd="12dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pago seguro con PayPal"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-condensed"
                            android:textColor="@color/accent_blue"
                            android:layout_marginBottom="2dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Serás redirigido a PayPal para autorizar el pago. Tus datos están protegidos."
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-light"
                            android:textColor="@color/text_secondary"
                            android:lineSpacingMultiplier="1.4" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Progress -->
            <ProgressBar
                android:id="@+id/progress_comprar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="8dp"
                android:indeterminateTint="@color/accent_primary" />

        </LinearLayout>
    </ScrollView>

    <!-- Botones fijos abajo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@color/bg_secondary"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <Button
            android:id="@+id/btn_pagar_paypal"
            style="@style/SS.Button.PayPal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:drawableStart="@drawable/ic_paypal"
            android:drawablePadding="8dp"
            android:text="  Pagar con PayPal" />

        <Button
            android:id="@+id/btn_cancelar_compra"
            style="@style/SS.Button.Ghost"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="Cancelar" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
