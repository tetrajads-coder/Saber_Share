<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true"
    android:overScrollMode="never">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Glow verde arriba derecha -->
        <View
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-40dp"
            android:layout_marginEnd="-40dp"
            android:background="@drawable/bg_glow_green"
            android:alpha="0.5" />

        <!-- Glow azul abajo izquierda -->
        <View
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="bottom|start"
            android:layout_marginBottom="80dp"
            android:layout_marginStart="-40dp"
            android:background="@drawable/bg_glow_blue"
            android:alpha="0.4" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="60dp"
            android:paddingBottom="40dp">

            <!-- Logo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="32dp">

                <!-- Ícono gradiente verde -->
                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginBottom="16dp">
                    <View
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_btn_green_gradient" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="🎓"
                        android:textSize="28sp" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Saber"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-condensed"
                        android:textColor="@color/text_primary" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Share"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-condensed"
                        android:textColor="@color/accent_primary" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Crea tu cuenta y empieza a aprender"
                    android:textSize="13sp"
                    android:textColor="@color/text_tertiary"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Card formulario -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Crear cuenta"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-condensed"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="* Campos obligatorios"
                        android:textSize="12sp"
                        android:textColor="@color/text_tertiary"
                        android:layout_marginBottom="20dp" />

                    <!-- Usuario -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilUsuario"
                        style="@style/SS.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Usuario *"
                        android:layout_marginBottom="12dp"
                        app:startIconDrawable="@drawable/ic_person"
                        app:startIconTint="@color/text_tertiary"
                        app:boxStrokeColor="@color/accent_blue">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etUsuario"
                            style="@style/SS.TextInput.EditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName"
                            android:imeOptions="actionNext" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Nombre + Apellido en fila -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilNombre"
                            style="@style/SS.TextInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Nombre *"
                            android:layout_marginEnd="6dp"
                            app:startIconDrawable="@drawable/ic_person"
                            app:startIconTint="@color/text_tertiary"
                            app:boxStrokeColor="@color/accent_blue">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etNombre"
                                style="@style/SS.TextInput.EditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPersonName"
                                android:imeOptions="actionNext" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilApellido"
                            style="@style/SS.TextInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Apellido"
                            android:layout_marginStart="6dp"
                            app:startIconDrawable="@drawable/ic_person"
                            app:startIconTint="@color/text_tertiary"
                            app:boxStrokeColor="@color/accent_blue">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etApellido"
                                style="@style/SS.TextInput.EditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPersonName"
                                android:imeOptions="actionNext" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- Correo -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilCorreo"
                        style="@style/SS.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Correo electrónico *"
                        android:layout_marginBottom="12dp"
                        app:startIconDrawable="@drawable/ic_email"
                        app:startIconTint="@color/text_tertiary"
                        app:boxStrokeColor="@color/accent_blue">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCorreo"
                            style="@style/SS.TextInput.EditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:imeOptions="actionNext" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Teléfono -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilTelefono"
                        style="@style/SS.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Teléfono"
                        android:layout_marginBottom="12dp"
                        app:startIconDrawable="@drawable/ic_email"
                        app:startIconTint="@color/text_tertiary"
                        app:boxStrokeColor="@color/accent_blue">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTelefono"
                            style="@style/SS.TextInput.EditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="phone"
                            android:imeOptions="actionNext" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Contraseña -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPass"
                        style="@style/SS.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Contraseña *"
                        android:layout_marginBottom="8dp"
                        app:startIconDrawable="@drawable/ic_lock"
                        app:startIconTint="@color/text_tertiary"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/text_tertiary"
                        app:boxStrokeColor="@color/accent_blue">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPassword"
                            style="@style/SS.TextInput.EditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:imeOptions="actionDone" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Error -->
                    <TextView
                        android:id="@+id/tv_error_registro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/error"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:visibility="gone"
                        android:background="#1AEF4444"
                        android:padding="10dp"
                        android:layout_marginBottom="8dp" />

                    <!-- Progress -->
                    <ProgressBar
                        android:id="@+id/progress_registro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:visibility="gone"
                        android:layout_marginBottom="8dp"
                        android:indeterminateTint="@color/accent_primary" />

                    <!-- Botón crear cuenta verde -->
                    <Button
                        android:id="@+id/btnRegistrarse"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_login_gradient"
                        android:text="✨  CREAR CUENTA"
                        android:textColor="@color/text_on_accent"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="0.05"
                        android:stateListAnimator="@null"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Ya tengo cuenta -->
            <Button
                android:id="@+id/btnIniciarSesion"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:text="¿Ya tienes cuenta? Iniciar sesión →"
                android:textColor="@color/accent_blue"
                android:textSize="14sp"
                android:textStyle="bold"
                android:stateListAnimator="@null" />

        </LinearLayout>
    </FrameLayout>
</ScrollView>