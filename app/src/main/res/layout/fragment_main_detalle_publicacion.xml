<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_detalle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_secondary"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_detalle"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrowback"
            app:navigationIconTint="@color/text_primary"
            app:titleTextColor="@color/text_primary"
            android:background="@color/bg_secondary" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Barra inferior FIJA con botones — va ANTES del ScrollView para que quede debajo -->
    <LinearLayout
        android:id="@+id/bar_acciones"
        android:elevation="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/bg_secondary"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="160dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_contactar"
                style="@style/SS.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Contactar" />

            <Button
                android:id="@+id/btn_calificar"
                style="@style/SS.Button.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_marginEnd="8dp"
                android:text="★"
                android:textSize="18sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_comprar"
                style="@style/SS.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1.4"
                android:text="COMPRAR" />

        </LinearLayout>

        <Button
            android:id="@+id/btn_agendar"
            style="@style/SS.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="8dp"
            android:text="📅 Agendar clase"
            android:visibility="gone" />

    </LinearLayout>

    <!-- ScrollView con padding suficiente para no quedar tapado -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:paddingBottom="220dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Tag tipo -->
            <TextView
                android:id="@+id/tv_detalle_tipo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CURSO"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:textColor="@color/accent_primary"
                android:background="@drawable/bg_tag_curso"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:layout_marginBottom="12dp" />

            <!-- Título -->
            <TextView
                android:id="@+id/tv_detalle_titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre de la publicación"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp" />

            <!-- Vendedor + Rating -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_avatar_gradient"
                    android:layout_marginEnd="10dp">
                    <TextView
                        android:id="@+id/tv_detalle_vendedor_inicial"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="V"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/bg_primary"
                        android:gravity="center" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_detalle_vendedor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vendedor"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_primary" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <RatingBar
                            android:id="@+id/ratingbar_detalle"
                            android:layout_width="wrap_content"
                            android:layout_height="16dp"
                            style="@style/Widget.AppCompat.RatingBar.Small"
                            android:numStars="5"
                            android:stepSize="0.1"
                            android:isIndicator="true"
                            android:progressTint="@color/star_filled"
                            android:secondaryProgressTint="@color/star_empty"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/tv_detalle_promedio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.0"
                            android:textSize="12sp"
                            android:textColor="@color/star_filled" />

                        <TextView
                            android:id="@+id/tv_detalle_total_reviews"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" (0 reseñas)"
                            android:textSize="12sp"
                            android:textColor="@color/text_tertiary" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Card precio -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/bg_card_elevated"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/accent_primary"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PRECIO"
                            android:textSize="10sp"
                            android:textColor="@color/text_tertiary"
                            android:letterSpacing="0.10" />

                        <TextView
                            android:id="@+id/tv_detalle_precio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$0.00 MXN"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-condensed"
                            android:textColor="@color/accent_primary" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💰"
                        android:textSize="32sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Descripción -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DESCRIPCIÓN"
                android:textSize="10sp"
                android:textColor="@color/text_tertiary"
                android:letterSpacing="0.10"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_detalle_descripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/text_secondary"
                android:lineSpacingMultiplier="1.6"
                android:layout_marginBottom="24dp" />

            <!-- Reseñas -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RESEÑAS"
                android:textSize="10sp"
                android:textColor="@color/text_tertiary"
                android:letterSpacing="0.10"
                android:layout_marginBottom="12dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_opiniones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>