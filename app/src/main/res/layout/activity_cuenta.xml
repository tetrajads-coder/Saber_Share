<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_cuenta.xml
    Contenedor de los fragmentos Login / Registro.
    Fondo oscuro con detalle geométrico decorativo.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- Círculo decorativo top-right (detalle visual) -->
    <View
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-80dp"
        android:layout_marginEnd="-80dp"
        android:alpha="0.06"
        android:background="@drawable/bg_circle_accent" />

    <!-- Círculo decorativo bottom-left -->
    <View
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="-60dp"
        android:layout_marginStart="-60dp"
        android:alpha="0.04"
        android:background="@drawable/bg_circle_accent" />

    <!-- NavHost de cuenta (Login / Registro) -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_cuenta"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true" />

</FrameLayout>
