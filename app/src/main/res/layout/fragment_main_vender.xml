<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="80dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Publicar"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:textColor="@color/text_primary"
            android:letterSpacing="-0.01"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Comparte tu conocimiento o servicio"
            android:textSize="13sp"
            android:fontFamily="sans-serif-light"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="24dp" />

        <!-- Selector tipo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TIPO DE PUBLICACIÓN"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_tertiary"
            android:letterSpacing="0.10"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:id="@+id/btn_tipo_curso"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_tipo_selected"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="📚" android:textSize="22sp" android:layout_marginBottom="2dp" />
                <TextView
                    android:id="@+id/tv_tipo_curso_label"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Curso" android:textSize="13sp" android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"
                    android:textColor="@color/accent_primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_tipo_servicio"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_tipo_unselected"
                android:clickable="true"
                android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🎓" android:textSize="22sp" android:layout_marginBottom="2dp" />
                <TextView
                    android:id="@+id/tv_tipo_servicio_label"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Clase 1a1" android:textSize="13sp" android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"
                    android:textColor="@color/text_tertiary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Título -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_titulo"
            style="@style/SS.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Título de la publicación"
            android:layout_marginBottom="14dp"
            app:counterEnabled="true"
            app:counterMaxLength="80">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_titulo"
                style="@style/SS.TextInput.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLength="80"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Descripción -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_descripcion"
            style="@style/SS.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Descripción detallada"
            android:layout_marginBottom="14dp"
            app:counterEnabled="true"
            app:counterMaxLength="500">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_descripcion"
                style="@style/SS.TextInput.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="4"
                android:maxLines="8"
                android:maxLength="500"
                android:gravity="top" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Precio -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_precio"
            style="@style/SS.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Precio (MXN)"
            android:layout_marginBottom="20dp"
            app:prefixText="$"
            app:prefixTextColor="@color/accent_primary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_precio"
                style="@style/SS.TextInput.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:imeOptions="actionDone" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- SECCIÓN CURSO -->
        <LinearLayout
            android:id="@+id/layout_seccion_curso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONTENIDO DEL CURSO"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_tertiary"
                android:letterSpacing="0.10"
                android:layout_marginBottom="10dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_archivo"
                style="@style/SS.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Archivo seleccionado"
                android:layout_marginBottom="10dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_nombre_archivo"
                    style="@style/SS.TextInput.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:hint="Ningún archivo seleccionado" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btn_seleccionar_archivo"
                style="@style/SS.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="📎 Seleccionar archivo"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Formatos: MP4, PDF, ZIP"
                android:textSize="12sp"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/text_tertiary"
                android:layout_marginBottom="20dp" />

        </LinearLayout>

        <!-- SECCIÓN CLASE -->
        <LinearLayout
            android:id="@+id/layout_seccion_clase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DETALLES DE LA CLASE"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_tertiary"
                android:letterSpacing="0.10"
                android:layout_marginBottom="10dp" />

            <!-- Modalidad -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Modalidad"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:id="@+id/btn_modalidad_online"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/bg_tipo_selected"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="💻  " android:textSize="16sp" />
                    <TextView
                        android:id="@+id/tv_modalidad_online_label"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="En línea" android:textSize="13sp" android:textStyle="bold"
                        android:textColor="@color/accent_primary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_modalidad_presencial"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/bg_tipo_unselected"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📍  " android:textSize="16sp" />
                    <TextView
                        android:id="@+id/tv_modalidad_presencial_label"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Presencial" android:textSize="13sp" android:textStyle="bold"
                        android:textColor="@color/text_tertiary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Duración -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_duracion"
                style="@style/SS.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Duración de la sesión (ej: 60 min)"
                android:layout_marginBottom="14dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_duracion"
                    style="@style/SS.TextInput.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:imeOptions="actionNext" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Fecha (DatePicker) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_fecha"
                style="@style/SS.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Fecha disponible"
                android:layout_marginBottom="14dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_fecha"
                    style="@style/SS.TextInput.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:hint="Seleccionar fecha 📅" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Hora (TimePicker) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_hora"
                style="@style/SS.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Hora disponible"
                android:layout_marginBottom="20dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_hora"
                    style="@style/SS.TextInput.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:hint="Seleccionar hora 🕐" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- Progress -->
        <ProgressBar
            android:id="@+id/progress_vender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="8dp"
            android:indeterminateTint="@color/accent_primary" />

        <TextView
            android:id="@+id/tv_error_vender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/error"
            android:textSize="13sp"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_publicar"
            style="@style/SS.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="PUBLICAR AHORA" />

    </LinearLayout>
</ScrollView>