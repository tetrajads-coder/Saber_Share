<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_secondary"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_gestionar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrowback"
            app:navigationIconTint="@color/text_primary"
            android:background="@color/bg_secondary"
            app:title="Gestionar horarios"
            app:titleTextColor="@color/text_primary" />

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Instrucciones -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Define los días y horas en que puedes dar esta clase."
            android:textSize="13sp"
            android:fontFamily="sans-serif-light"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="16dp" />

        <!-- Botón agregar slot -->
        <Button
            android:id="@+id/btnAgregarSlot"
            style="@style/SS.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="+ Agregar nueva fecha" />

        <!-- Label lista -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TUS HORARIOS"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_tertiary"
            android:letterSpacing="0.10"
            android:layout_marginBottom="10dp" />

        <!-- Estado vacío -->
        <TextView
            android:id="@+id/tvVacioProfe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No has creado horarios aún."
            android:textSize="14sp"
            android:fontFamily="sans-serif-light"
            android:textColor="@color/text_tertiary"
            android:gravity="center"
            android:layout_marginTop="40dp"
            android:visibility="gone" />

        <!-- Lista de slots -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMisSlots"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>